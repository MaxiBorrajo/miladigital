---
import { plans, waLink, WA_CELES } from "../data/site";
import CheckIcon from "./icons/CheckIcon.astro";
---

<section id="planes" class="relative py-[100px] z-2 bg-band-light-soft">
  <div class="wrap max-w-[1440px] mx-auto px-7 md:px-[88px] relative z-2">
    <div
      class="reveal flex flex-col items-center text-center gap-4 max-w-[640px] mx-auto mb-14"
    >
      <div class="flex flex-col items-center gap-4">
        <span
          class="font-body text-[12.5px] font-semibold text-muted tracking-[0.02em] inline-block px-3.5 py-1.5 rounded-full border border-border bg-surface whitespace-nowrap"
          >Planes</span
        >
        <h2 class="font-serif font-medium text-[clamp(28px,3.6vw,42px)] leading-tight">
          Elegí el plan que acompaña tu etapa.
        </h2>
      </div>
      <p class="mt-0 text-muted text-base leading-relaxed">
        Todos incluyen estrategia mensual y reportes claros. Escalá cuando
        estés listo.
      </p>
    </div>
    <div class="grid grid-cols-3 gap-[22px] items-stretch max-md:grid-cols-1">
      {
        plans.map((p) => (
          <div
            class:list={[
              "reveal bg-surface border border-border rounded-2xl px-[30px] py-9 flex flex-col relative transition-transform duration-350 hover:-translate-y-1.5",
              { "border-[1.5px] border-celeste": p.featured },
            ]}
          >
            {p.featured && (
              <span class="absolute -top-[13px] left-[30px] bg-celeste text-[#050507] font-mono text-[11px] font-bold px-4 py-1.5 rounded-full whitespace-nowrap">
                Más elegido
              </span>
            )}
            <div class="font-serif font-medium text-xl mb-2">{p.name}</div>
            <div class="text-muted text-[13.5px] mb-[22px] min-h-[38px]">{p.desc}</div>
            <div class="font-serif font-medium text-4xl">${p.price}</div>
            <div class="text-muted text-[12.5px] font-mono mb-[26px]">/ MES</div>
            <ul class="list-none flex flex-col gap-[13px] mb-[30px] flex-1">
              {p.features.map((f) => (
                <li class="flex gap-2.5 text-[13.5px] text-ink items-start">
                  <CheckIcon class="text-celeste mt-0.5" />
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={waLink(WA_CELES)}
              target="_blank"
              rel="noopener"
              class:list={[
                "inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[10px] font-semibold text-[14.5px] text-center no-underline cursor-pointer border-none font-body transition-[transform,box-shadow] duration-250 hover:-translate-y-0.5",
                p.featured
                  ? "bg-celeste text-[#050507]"
                  : "border border-border text-ink bg-transparent hover:border-white/30",
              ]}
            >
              Elegir plan
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
