---
import { waLink, WA_CELES, WA_CAMI, IG_URL } from "../data/site";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
---

<section id="contacto" class="relative py-[100px] z-2 bg-band-cta">
  <div class="wrap max-w-[1440px] mx-auto px-7 md:px-[88px] relative z-2">
    <div
      class="reveal bg-surface border border-border rounded-[20px] p-14 grid grid-cols-[1.2fr_0.8fr] gap-[50px] items-center relative max-md:grid-cols-1 max-md:px-[26px] max-md:py-9 max-md:rounded-2xl max-md:text-center"
    >
      <div class="contact-left">
        <h2 class="font-serif font-medium text-[clamp(26px,3vw,36px)] mb-4">
          Hablemos de tu próximo lanzamiento.
        </h2>
        <p class="text-muted leading-[1.7] mb-7 max-w-[420px] max-md:mx-auto">
          Contanos qué necesita tu marca. Te respondemos directo, sin
          formularios eternos ni esperas.
        </p>
        <div class="flex flex-col gap-4">
          <a
            href={waLink(WA_CELES)}
            target="_blank"
            rel="noopener"
            class="text-ink no-underline flex items-center gap-3 text-[14.5px] transition-colors duration-250 hover:text-celeste max-md:justify-center"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-[18px] h-[18px] text-celeste shrink-0"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.79.63 2.65a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.43-1.2a2 2 0 0 1 2.11-.45c.86.3 1.75.5 2.65.63A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
            Celes · +54 9 11 7036-5216
          </a>
          <a
            href={waLink(WA_CAMI)}
            target="_blank"
            rel="noopener"
            class="text-ink no-underline flex items-center gap-3 text-[14.5px] transition-colors duration-250 hover:text-celeste max-md:justify-center"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-[18px] h-[18px] text-celeste shrink-0"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.79.63 2.65a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.43-1.2a2 2 0 0 1 2.11-.45c.86.3 1.75.5 2.65.63A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
            Cami · +54 9 11 5409-1703
          </a>
          <a
            href={IG_URL}
            target="_blank"
            rel="noopener"
            class="text-ink no-underline flex items-center gap-3 text-[14.5px] transition-colors duration-250 hover:text-celeste max-md:justify-center"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-[18px] h-[18px] text-celeste shrink-0"
              ><rect x="2" y="2" width="20" height="20" rx="5"
              ></rect><circle cx="12" cy="12" r="4"></circle><circle
                cx="17.5"
                cy="6.5"
                r="1"></circle></svg
            >
            @Miladigital.ar
          </a>
        </div>
      </div>
      <div class="relative z-2 flex flex-col items-center gap-3">
        <a
          href={waLink(WA_CELES)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-[10px] font-semibold no-underline cursor-pointer border-none font-body transition-[transform,box-shadow] duration-250 bg-celeste text-[#050507] hover:-translate-y-0.5 px-[34px] py-[17px] text-base w-full"
        >
          <WhatsAppIcon size={20} />
          Escribinos por WhatsApp
        </a>
        <p class="text-muted text-[13px] text-center">Te respondemos en menos de 24hs hábiles.</p>
      </div>
    </div>
  </div>
</section>
