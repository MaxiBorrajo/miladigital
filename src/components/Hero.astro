---
import { waLink, WA_CELES } from "../data/site";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
import CheckIcon from "./icons/CheckIcon.astro";
---

<section
  class="relative overflow-hidden py-[172px] pb-[110px] max-md:pt-[140px] max-md:pb-20 bg-band-cta"
  id="inicio"
>
  <div
    class="wrap max-w-[1440px] mx-auto px-7 md:px-[88px] relative z-2 grid grid-cols-[1.05fr_0.95fr] gap-10 items-center max-[980px]:grid-cols-1 max-[980px]:text-center"
  >
    <div class="hero-copy">
      <h1 class="flex flex-col gap-[-6px] leading-[1.05] max-[980px]:items-center max-[980px]:gap-[-4px]">
        <span
          class="font-serif font-normal italic text-[clamp(18px,2vw,24px)] max-[980px]:text-[clamp(17px,4.4vw,24px)] text-muted leading-none"
          >Hacemos que tu marca</span
        >
        <span
          class="font-serif font-medium text-[clamp(96px,16vw,150px)] max-[980px]:text-[clamp(50px,15vw,88px)] text-celeste leading-none"
          >se note</span
        >
      </h1>
      <p
        class="mt-[22px] text-[17.5px] text-muted max-w-[480px] leading-[1.65] max-[980px]:mx-auto"
      >
        Community management, contenido y landing pages para marcas que
        quieren crecer en serio. Estrategia primero, contenido después.
      </p>
      <div class="flex gap-3.5 mt-9 flex-wrap max-[980px]:justify-center">
        <a
          href={waLink(WA_CELES)}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[10px] font-semibold text-[14.5px] no-underline cursor-pointer border-none font-body transition-[transform,box-shadow] duration-250 bg-celeste text-[#050507] hover:-translate-y-0.5"
        >
          <WhatsAppIcon size={18} />
          Quiero mi diagnóstico gratis
        </a>
        <a
          href="#planes"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[10px] font-semibold text-[14.5px] no-underline cursor-pointer font-body transition-[transform,box-shadow] duration-250 border border-border text-ink bg-transparent hover:border-white/30 hover:-translate-y-0.5"
          >Ver planes y precios</a
        >
      </div>
      <ul
        class="list-none flex flex-col gap-3 mt-10 max-[980px]:items-center"
      >
        <li class="flex items-center gap-2.5 text-sm text-ink">
          <CheckIcon class="text-celeste" />Trato directo con las socias
        </li>
        <li class="flex items-center gap-2.5 text-sm text-ink">
          <CheckIcon class="text-celeste" />Estrategia antes que contenido
        </li>
        <li class="flex items-center gap-2.5 text-sm text-ink">
          <CheckIcon class="text-celeste" />Informe real cada mes
        </li>
      </ul>
    </div>

    <div
      class="flex items-center justify-center max-[980px]:order-[-1] max-[980px]:mb-5"
      aria-hidden="true"
    >
      <div
        class="animate-gentle-float w-full max-w-[360px] aspect-square mx-auto p-[15%] box-border rounded-[20px] border border-border bg-surface flex items-center justify-center max-[980px]:max-w-[260px]"
      >
        <img
          src="/logo-mark.png"
          alt="Isotipo Mila Digital"
          width="220"
          height="220"
          class="w-full h-full object-contain"
        />
      </div>
    </div>
  </div>
</section>
