---
import { services, addons, waLink, WA_CELES } from "../data/site";
---

<section id="servicios" class="band band-plum">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="section-head-title">
        <span class="tag">Qué hacemos</span>
        <h2>Todo lo que tu marca necesita para existir online, bien.</h2>
      </div>
      <p>
        Tres frentes, un mismo objetivo: que te vean, que te recuerden y que
        te elijan.
      </p>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card reveal">
            <div class="service-icon">
              {s.icon === "chat" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#1cc8ff"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M18 8a3 3 0 1 0-2.83-4H15a3 3 0 0 0 0 6 2.98 2.98 0 0 0 1.98-.75l6.02 3.5m-8-2.75-6.02 3.5M18 20a3 3 0 1 0-2.83-4H15a3 3 0 0 0 0 6 2.98 2.98 0 0 0 1.98-.75" />
                  <circle cx="6" cy="12" r="3" />
                </svg>
              )}
              {s.icon === "spark" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#6d38ff"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M9 8h6M9 12h6M9 16h4" />
                </svg>
              )}
              {s.icon === "layout" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#c70bf6"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M4 4h16v4H4z" />
                  <path d="M4 12h16M4 16h10M4 20h6" />
                </svg>
              )}
            </div>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
            <div class="service-tags">
              {s.tags.map((t) => (
                <span class="pill-tag">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="addons reveal">
      <div class="addons-head">
        <h3>¿Necesitás algo puntual?</h3>
        <p>
          Sumá servicios a medida cuando los necesites, sin atarte a un plan.
        </p>
      </div>
      <div class="addons-chips">
        {
          addons.map((a) => (
            <span class="addon-chip">
              <>
                <b>{a.name}</b>
                <i>{a.price}</i>
              </>
            </span>
          ))
        }
      </div>
      <a
        href={waLink(WA_CELES)}
        target="_blank"
        rel="noopener"
        class="link-cta">Consultanos por cualquier otro servicio →</a
      >
    </div>
  </div>
</section>
