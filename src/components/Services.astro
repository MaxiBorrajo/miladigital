---
import { services, projectServices, addons, waLink, WA_CELES } from "../data/site";
---

<section id="servicios" class="band band-plum band-plum-soft">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="section-head-title">
        <span class="tag">Qué hacemos</span>
        <h2>Todo lo que tu marca necesita para existir online, bien.</h2>
      </div>
      <p>
        Tres frentes, un mismo objetivo: que te vean, que te recuerden y que
        te elijan.
      </p>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card reveal">
            <div class="service-icon">
              {s.icon === "chat" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-celeste)"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M18 8a3 3 0 1 0-2.83-4H15a3 3 0 0 0 0 6 2.98 2.98 0 0 0 1.98-.75l6.02 3.5m-8-2.75-6.02 3.5M18 20a3 3 0 1 0-2.83-4H15a3 3 0 0 0 0 6 2.98 2.98 0 0 0 1.98-.75" />
                  <circle cx="6" cy="12" r="3" />
                </svg>
              )}
              {s.icon === "spark" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-violeta)"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M9 8h6M9 12h6M9 16h4" />
                </svg>
              )}
              {s.icon === "layout" && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-rosa)"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M4 4h16v4H4z" />
                  <path d="M4 12h16M4 16h10M4 20h6" />
                </svg>
              )}
            </div>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
            <div class="service-tags">
              {s.tags.map((t) => (
                <span class="pill-tag">{t}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="addons reveal">
      <div class="addons-head">
        <h3>¿Necesitás algo puntual?</h3>
        <p>
          Sumá servicios a medida cuando los necesites, sin atarte a un plan.
        </p>
      </div>
      <div class="addons-chips">
        {
          addons.map((a) => (
            <span class="addon-chip">
              <>
                <b>{a.name}</b>
                <i>{a.price}</i>
              </>
            </span>
          ))
        }
      </div>
      <a
        href={waLink(WA_CELES)}
        target="_blank"
        rel="noopener"
        class="link-cta">Consultanos por cualquier otro servicio →</a
      >
    </div>

    <div class="dev-panel reveal">
      <div class="addons-head">
        <h3>¿Necesitás desarrollo a medida?</h3>
        <p>
          Páginas web, apps para pymes, automatizaciones con IA y
          migraciones. Cada proyecto es distinto: nos contactamos y armamos
          un presupuesto a medida.
        </p>
      </div>
      <div class="dev-services-grid">
        {
          projectServices.map((s) => (
            <div class="dev-service">
              <div class="dev-service-icon">
                {s.icon === "web" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-celeste)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18" />
                    <path d="M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z" />
                  </svg>
                )}
                {s.icon === "app" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-violeta)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="2" width="12" height="20" rx="2" />
                    <path d="M10 18h4" />
                  </svg>
                )}
                {s.icon === "ai" && (
                  <svg viewBox="0 0 24 24" fill="var(--color-rosa)" stroke="none">
                    <path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Z" />
                  </svg>
                )}
                {s.icon === "migrate" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-azul)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 7h11l-3-3" />
                    <path d="M17 17H6l3 3" />
                  </svg>
                )}
              </div>
              <div>
                <h4>{s.name}</h4>
                <p>{s.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
      <a
        href={waLink(WA_CELES, "¡Hola! Quiero cotizar un proyecto de desarrollo (web, app, automatización o migración) con Mila Digital 🚀")}
        target="_blank"
        rel="noopener"
        class="btn btn-primary">Quiero cotizar mi proyecto</a
      >
    </div>
  </div>
</section>
