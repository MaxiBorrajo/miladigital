---
import { waLink, WA_CELES } from "../data/site";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";
---

<a
  href={waLink(WA_CELES)}
  target="_blank"
  rel="noopener"
  class="fixed bottom-[26px] right-[26px] w-[58px] h-[58px] rounded-full z-60 bg-[#25d366] text-white flex items-center justify-center shadow-[0_6px_16px_-4px_rgba(0,0,0,0.4)]"
  aria-label="Escribinos por WhatsApp"
>
  <WhatsAppIcon size={26} />
</a>
