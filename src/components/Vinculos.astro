---
import { pillars } from "../data/site";
---

<section id="vinculos" class="relative py-[100px] z-2 bg-band-light-soft">
  <div class="wrap max-w-[1440px] mx-auto px-7 md:px-[88px] relative z-2">
    <div
      class="reveal flex flex-col items-center text-center gap-4 max-w-[640px] mx-auto mb-14"
    >
      <div class="flex flex-col items-center gap-4">
        <span
          class="font-body text-[12.5px] font-semibold text-muted tracking-[0.02em] inline-block px-3.5 py-1.5 rounded-full border border-border bg-surface whitespace-nowrap"
          >Por qué elegirnos</span
        >
        <h2 class="font-serif font-medium text-[clamp(28px,3.6vw,42px)] leading-tight">
          Creando vínculos, no solo publicaciones.
        </h2>
      </div>
    </div>
    <div class="grid grid-cols-4 gap-5 max-md:grid-cols-2 max-sm:grid-cols-1">
      {
        pillars.map((p) => (
          <div class="reveal border border-border rounded-[14px] px-[22px] py-[26px]">
            <h4 class="font-serif font-medium text-lg mb-2.5 text-celeste">{p.title}</h4>
            <p class="text-muted text-sm leading-[1.6]">{p.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
