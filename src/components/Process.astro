---
import { steps } from "../data/site";
---

<section id="trabajo" class="band band-plum band-plum-soft">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="section-head-title">
        <span class="tag">Cómo trabajamos</span>
        <h2>Un proceso claro, de punta a punta.</h2>
      </div>
      <p>
        Sin sorpresas: sabés qué pasa en cada etapa, desde la primera charla
        hasta el informe de resultados.
      </p>
    </div>
    <ol class="steps-grid">
      {
        steps.map((s) => (
          <li class="step-card reveal">
            <span class="step-n">{s.n}</span>
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
